
@page
@model IndexModel
@{
    ViewData["Title"] = "Class Management";
}

@if (!HttpContext.User.Identity.IsAuthenticated && string.IsNullOrEmpty(HttpContext.Request.Cookies["username"]))
{
    <div class="alert alert-danger text-center mt-5" role="alert">
        🚫 You must be logged in to view this page. <a href="/Login">Go to Login</a>
    </div>
    return;
}

<style>
    body {
        background: linear-gradient(to right, #e3f2fd, #f1f8e9);
        font-family: 'Segoe UI', sans-serif;
    }

    .card {
        border-radius: 20px;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.1);
        transition: transform 0.2s ease-in-out;
    }

    .card:hover {
        transform: scale(1.01);
    }

    .btn-primary {
        background-color: #00b894;
        border: none;
        transition: background-color 0.3s ease;
    }

    .btn-primary:hover {
        background-color: #00a383;
    }

    .btn-warning {
        background-color: #fdcb6e;
        border: none;
        color: #333;
        transition: background-color 0.3s ease;
    }

    .btn-warning:hover {
        background-color: #faae43;
    }

    .btn-danger {
        background-color: #d63031;
        border: none;
        transition: background-color 0.3s ease;
    }

    .btn-danger:hover {
        background-color: #c0392b;
    }

    .card-header {
        border-top-left-radius: 20px;
        border-top-right-radius: 20px;
    }

    .form-label {
        font-weight: bold;
        color: #37474f;
    }

    .table-hover tbody tr:hover {
        background-color: #f1f1f1;
    }

    .table td, .table th {
        vertical-align: middle;
    }

    .pagination {
        margin-top: 40px;
        gap: 20px;
        justify-content: center;
    }

    .pagination .page-link {
        border-radius: 12px;
        padding: 10px 20px;
        background-color: #ffffff;
        border: 1px solid #00b894;
        color: #00b894;
        font-weight: bold;
        box-shadow: 0 3px 8px rgba(0, 0, 0, 0.05);
        transition: all 0.3s ease;
    }

    .pagination .page-link:hover {
        background-color: #00b894;
        color: #ffffff;
    }

    .pagination .disabled .page-link {
        background-color: #ccc;
        color: #666;
        border: 1px solid #aaa;
        cursor: not-allowed;
    }

    .clickable-header {
        cursor: pointer;
    }

    .clickable-header.table-success {
        background-color: #55efc4 !important;
        color: #2d3436 !important;
    }

    .logout-bottom-left {
        margin-top: 10px;
    }
</style>

<div class="container mt-5">

    <h2 class="text-center mb-4 text-primary">🎓 Class Management System 🎓</h2>

    <div class="row">
        <div class="col-md-4 mb-4">
            <div class="card">
                <div class="card-header bg-gradient text-white text-center" style="background: linear-gradient(to right, #00cec9, #0984e3);">
                    <h5 class="mb-0">@((Model.NewClass.Id == 0) ? "➕ Add New Class" : "✏️ Update Class")</h5>
                </div>
                <div class="card-body">
                    <form method="post">
                        <div class="form-group mb-3 selectable-input" data-index="0">
                            <label for="ClassName" class="form-label">📘 Class Name</label>
                            <input type="text" class="form-control" asp-for="NewClass.ClassName" id="ClassName" placeholder="Enter class name" />
                            <span asp-validation-for="NewClass.ClassName" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3 selectable-input" data-index="1">
                            <label for="StudentCount" class="form-label">👥 Student Count</label>
                            <input type="number" class="form-control" asp-for="NewClass.StudentCount" id="StudentCount" placeholder="Enter student count" />
                            <span asp-validation-for="NewClass.StudentCount" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3 selectable-input" data-index="2">
                            <label for="Description" class="form-label">📝 Description</label>
                            <textarea class="form-control" asp-for="NewClass.Description" id="Description" rows="3" placeholder="Enter description"></textarea>
                            <span asp-validation-for="NewClass.Description" class="text-danger"></span>
                        </div>

                        <input type="hidden" asp-for="NewClass.Id" />

                        <button type="submit" asp-page-handler="@((Model.NewClass.Id == 0) ? "Add" : "Update")" class="btn btn-primary w-100 mt-3 fs-5">
                            @((Model.NewClass.Id == 0) ? "➕ Add Class" : "💾 Update Class")
                        </button>
                    </form>

                    
                    <form method="post" asp-page-handler="Logout" class="logout-bottom-left">
                        <button type="submit" class="btn btn-outline-danger w-100 mt-2">🚪 Logout</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-dark text-white text-center">
                    <h5 class="mb-0">📋 Class List</h5>
                </div>
                <div class="card-body">
                    <form method="get" class="mb-3">
                        <div class="row g-2">
                            <div class="col-md-10">
                                <input type="text" class="form-control" name="SearchTerm" value="@Model.SearchTerm" placeholder="🔍 Search class name, student count, or description" />
                            </div>
                            <div class="col-md-2">
                                <button type="submit" class="btn btn-primary w-100">Search</button>
                            </div>
                        </div>
                    </form>

                    <form method="post" asp-page-handler="ExportJson">
                        <input type="hidden" name="isFiltered" value="true" />
                        <input type="hidden" id="SelectedColumnsInput" name="selectedColumns" />
                        <input type="hidden" name="SearchTerm" value="@Model.SearchTerm" />
                        <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
                        <button type="submit" class="btn btn-secondary mb-3">⬇️ Export JSON</button>
                    </form>

                    <div class="table-responsive">
                        <table class="table table-hover table-bordered text-center align-middle">
                            <thead class="table-dark">
                                <tr>
                                    <th class="clickable-header" data-index="0">📘 Class Name</th>
                                    <th class="clickable-header" data-index="1">👥 Students</th>
                                    <th class="clickable-header" data-index="2">📝 Description</th>
                                    <th>⚙️ Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.FilteredClasses.Any())
                                {
                                    @foreach (var item in Model.FilteredClasses)
                                    {
                                        <tr>
                                            <td class="text-start">@item.ClassName</td>
                                            <td>@item.StudentCount</td>
                                            <td class="text-start">@item.Description</td>
                                            <td>
                                                <form method="post" class="d-inline">
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <button type="submit" asp-page-handler="Edit" class="btn btn-warning btn-sm" title="Edit">✏️</button>
                                                    <button type="submit" asp-page-handler="Delete" class="btn btn-danger btn-sm" title="Delete" onclick="return confirm('Are you sure you want to delete this class?');">❌</button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center">🚫 No classes found.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <nav>
                        <ul class="pagination">
                            <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                                <a class="page-link" asp-page="./Index" asp-route-PageNumber="@(Model.PageNumber - 1)" asp-route-SearchTerm="@Model.SearchTerm">⬅️ Previous</a>
                            </li>
                            <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" asp-page="./Index" asp-route-PageNumber="@(Model.PageNumber + 1)" asp-route-SearchTerm="@Model.SearchTerm">Next ➡️</a>
                            </li>
                        </ul>
                    </nav>

                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const selectedColumns = new Set();

    function updateSelectedColumnsInput() {
        const selected = Array.from(selectedColumns).sort().join(",");
        document.getElementById("SelectedColumnsInput").value = selected;
    }

    document.querySelectorAll(".clickable-header").forEach(header => {
        header.addEventListener("click", () => {
            const index = header.getAttribute("data-index");
            const columnCells = document.querySelectorAll(`td:nth-child(${parseInt(index) + 1}), th:nth-child(${parseInt(index) + 1})`);

            if (selectedColumns.has(index)) {
                selectedColumns.delete(index);
                header.classList.remove("table-success");
                columnCells.forEach(cell => cell.classList.remove("table-success"));
            } else {
                selectedColumns.add(index);
                header.classList.add("table-success");
                columnCells.forEach(cell => cell.classList.add("table-success"));
            }

            updateSelectedColumnsInput();
        });
    });
</script>
